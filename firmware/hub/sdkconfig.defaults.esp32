# DeskRadar build: classic ESP32-WROOM devkit + GC9A01 (boards/deskradar_esp32.c)
# Its own OTA channel: this image must never reach a C6 or P4 board, or the reverse.
CONFIG_HUB_FW_CHANNEL="hub-esp32"
# 4 MB flash: two 1.25 MB app slots (OTA can never change the table -> stay < 1.25 MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
# Console (and Improv WiFi setup) on UART0, through the devkit's CH340
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
