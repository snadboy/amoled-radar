# Common to every board. Target-specific settings: sdkconfig.defaults.<target>
# (ESP-IDF applies them automatically after this file).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# Same table as firmware/radar: OTA can never change it (two 2 MB app slots -> every
# build must stay < 2 MB).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# OTA from the LAN hub (plain HTTP: the board can't use Tailscale), with rollback:
# a new image must call ota_mark_good() after drawing or the bootloader reverts.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# LVGL: libc heap (a fixed pool left too little room for WiFi on the Arduino build),
# no OS integration (ui.c serialises access with its own mutex).
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_DRAW_BUF_ALIGN=4
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_USE_LOG=n
