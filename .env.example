# Home Assistant (outdoor temp/humidity, office occupancy + lux for screen control)
HASS_SERVER=
HASS_TOKEN=
# OpenSky Network API client (aircraft app)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Aircraft view centre. The repo is public, so the exact home position lives only here.
AIR_LAT=
AIR_LON=
# Optional overrides
RADAR_TEMP_ENTITY=sensor.outdoor_temperature
RADAR_HUM_ENTITY=sensor.outdoor_humidity
# AIR_POLL_S=30  AIR_IDLE_AFTER_S=120  AIR_HIDE_GROUND=1  AIR_LOOKUP_GAP_S=1.0
